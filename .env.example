# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Database (used by docker-compose, TypeORM and the seed)
POSTGRES_USER=root
POSTGRES_PASSWORD=123
POSTGRES_DB=db

DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=123
DB_NAME=db
# Never enable in production; migrations are the source of truth.
DB_SYNCHRONIZE=false

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Seed user (created by `npm run seed`)
SEED_EMAIL=author@nuvve.dev
SEED_PASSWORD=change-me-123
SEED_NAME=Nuvve Author
